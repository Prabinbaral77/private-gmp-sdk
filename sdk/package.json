{
  "name": "@venture23-aleo/aleo-sdk-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the Venture23 Aleo SDK and its test harness.",
  "license": "MIT",
  "author": "Venture23 Aleo Team",
  "engines": {
    "node": ">=18.17"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --reporter=append-only run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "implementation": "pnpm --filter @venture23-aleo/implementation run start",
    "derive": "pnpm --filter @venture23-aleo/implementation run start derive",
    "scan": "pnpm --filter @venture23-aleo/implementation run start scan",
    "consumer": "pnpm --filter @venture23-aleo/implementation run start consumer",
    "execute": "pnpm --filter @venture23-aleo/implementation run start execute",
    "vault-claim": "pnpm --filter @venture23-aleo/implementation run start vault-claim",
    "vault-withdraw": "pnpm --filter @venture23-aleo/implementation run start vault-withdraw",
    "vault-refund": "pnpm --filter @venture23-aleo/implementation run start vault-refund",
    "mapping": "pnpm --filter @venture23-aleo/implementation run start mapping"
  },
  "devDependencies": {
    "prettier": "^3.2.5"
  }
}
