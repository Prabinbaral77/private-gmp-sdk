{
  "name": "@venture23-aleo/private-gmp-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK to support Private GMP on the top of sodax SDK",
  "license": "MIT",
  "author": "Venture23 Aleo Team",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.cjs"
    },
    "./derivation": {
      "types": "./dist/derivation/index.d.ts",
      "import": "./dist/derivation/index.js",
      "require": "./dist/derivation/index.cjs"
    },
    "./scanner": {
      "types": "./dist/scanner/index.d.ts",
      "import": "./dist/scanner/index.js",
      "require": "./dist/scanner/index.cjs"
    },
    "./fee-sponsor": {
      "types": "./dist/fee-sponsor/index.d.ts",
      "import": "./dist/fee-sponsor/index.js",
      "require": "./dist/fee-sponsor/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "clean": "rimraf dist coverage .turbo",
    "dev": "tsup --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run lint && npm run typecheck && npm run build",
    "release": "npm run prepublishOnly && npm publish --access public"
  },
  "dependencies": {
    "@provablehq/sdk": "*"
  },
  "peerDependencies": {
    "@provablehq/sdk": "*"
  },
  "peerDependenciesMeta": {
    "@provablehq/sdk": { "optional": true }
  },
  "devDependencies": {
    "@provablehq/sdk": "^0.10.3",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-unused-imports": "^3.1.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  },
  "keywords": [
    "aleo",
    "sdk",
    "blockchain",
    "smart-contracts",
    "zero-knowledge",
    "leo",
    "sodax",
    "wallet",
    "privacy",
    "private-gmp"
  ],
  "publishConfig": {
    "access": "public"
  }
}
