{
  "name": "@venture23-aleo/implementation",
  "version": "0.0.0",
  "private": true,
  "description": "Local CLI app that exercises every flow exposed by @venture23-aleo/private-gmp-sdk.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "tsx --tsconfig tsconfig.json src/index.ts",
    "derive": "tsx --tsconfig tsconfig.json src/index.ts derive",
    "scan": "tsx --tsconfig tsconfig.json src/index.ts scan",
    "sponsor": "tsx --tsconfig tsconfig.json src/index.ts sponsor",
    "execute": "tsx --tsconfig tsconfig.json src/index.ts execute",
    "vault-claim": "tsx --tsconfig tsconfig.json src/index.ts vault-claim",
    "vault-withdraw": "tsx --tsconfig tsconfig.json src/index.ts vault-withdraw",
    "vault-refund": "tsx --tsconfig tsconfig.json src/index.ts vault-refund",
    "mapping": "tsx --tsconfig tsconfig.json src/index.ts mapping",
    "test": "tsx --test --test-reporter=spec tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^1.1.1",
    "@provablehq/sdk": "^0.10.3",
    "@solana/web3.js": "^1.95.0",
    "@stacks/transactions": "^7.0.0",
    "@stellar/stellar-sdk": "^12.0.0",
    "@venture23-aleo/private-gmp-sdk": "workspace:*",
    "bitcoinjs-lib": "^6.1.5",
    "bitcoinjs-message": "^2.2.0",
    "bs58": "^5.0.0",
    "dotenv": "^16.4.5",
    "ecpair": "^2.1.0",
    "ethers": "^6.11.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  }
}
