# Aleo network endpoint (testnet3 / mainnet / custom RPC)
ALEO_NETWORK=testnet
ALEO_RPC_URL=https://api.explorer.aleo.org/v1

# Default program identifier used by examples (e.g. "credits.aleo")
ALEO_DEFAULT_PROGRAM=credits.aleo

# Wallet (Sodax) configuration
SODAX_API_KEY=
SODAX_PROJECT_ID=

# Caller identity (only used by examples — never commit a real private key)
ALEO_PRIVATE_KEY=
ALEO_VIEW_KEY=
ALEO_ADDRESS=

# Default fee in microcredits
ALEO_DEFAULT_FEE=300000

# Optional: log level (debug | info | warn | error | silent)
LOG_LEVEL=info
